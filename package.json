{
  "name": "naql365",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:staging:db": "node scripts/staging/verify-database.mjs",
    "test:staging:services": "node scripts/staging/verify-services.mjs",
    "test:staging:browser": "playwright test --config playwright.staging.config.ts",
    "test:staging:acceptance": "node scripts/staging/verify-browser.mjs",
    "test:staging:intake": "node scripts/staging/verify-intake.mjs",
    "test:staging:phase2": "node scripts/staging/verify-phase2.mjs",
    "staging:configure-intake": "node scripts/staging/configure-intake.mjs --apply",
    "staging:configure-pricing": "node scripts/staging/configure-pricing.mjs --apply",
    "test:db": "supabase test db",
    "db:start": "node scripts/start-supabase.mjs",
    "db:reset": "supabase db reset",
    "db:types": "node scripts/generate-db-types.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
